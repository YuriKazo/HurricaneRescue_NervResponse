<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900.0" prefWidth="1600.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.LoginController">
   <left>
      <VBox prefHeight="901.0" prefWidth="350.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Pane prefHeight="1047.0" prefWidth="586.0" styleClass="sidebar-background">
               <children>
                  <Button fx:id="navHome" alignment="BASELINE_LEFT" graphicTextGap="50.0" layoutX="8.0" layoutY="194.0" mnemonicParsing="false" onAction="#goToHome" prefHeight="72.0" prefWidth="334.0" styleClass="nav-button" text="Home">
                     <graphic>
                        <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/home-icon.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="navMap" alignment="BASELINE_LEFT" graphicTextGap="50.0" layoutX="8.0" layoutY="297.0" mnemonicParsing="false" onAction="#goToMap" prefHeight="72.0" prefWidth="334.0" styleClass="nav-button" text="Map">
                     <graphic>
                        <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/map-icon.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="navCreateRequest" alignment="BASELINE_LEFT" graphicTextGap="50.0" layoutX="8.0" layoutY="403.0" mnemonicParsing="false" onAction="#goToCreateReliefRequest" prefHeight="72.0" prefWidth="334.0" styleClass="nav-button" text="Create Relief Request">
                     <graphic>
                        <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/request-icon.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="navLogin" alignment="BASELINE_LEFT" graphicTextGap="50.0" layoutX="8.0" layoutY="503.0" mnemonicParsing="false" onAction="#goToLogin" prefHeight="72.0" prefWidth="334.0" styleClass="nav-button" text="Login">
                     <graphic>
                        <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/login-logo.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="navSignUp" alignment="BASELINE_LEFT" graphicTextGap="50.0" layoutX="5.0" layoutY="604.0" mnemonicParsing="false" onAction="#goToSignUp" prefHeight="72.0" prefWidth="334.0" styleClass="nav-button" text="Sign Up">
                     <graphic>
                        <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/sign-up-logo.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <AnchorPane prefHeight="200.0" prefWidth="270.0">
                     <children>
                        <Label alignment="TOP_LEFT" layoutX="180.0" layoutY="13.0" prefHeight="155.0" prefWidth="157.0" styleClass="website-name" text="HURRICANE&#10;RELIEF&#10;TRACKER" />
                        <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="14.0" layoutY="13.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/hurricane-logo.png" />
                           </image>
                        </ImageView>
                     </children>
                  </AnchorPane>
               </children>
            </Pane>
         </children>
      </VBox>
   </left>
   <center>
      <AnchorPane prefHeight="907.0" prefWidth="1301.0" styleClass="main-background" BorderPane.alignment="CENTER">
         <children>
            <Pane layoutX="37.0" layoutY="33.0" prefHeight="836.0" prefWidth="1175.0" styleClass="form-background">
               <children>
                  <Label fx:id="lbl_error" layoutX="598.0" layoutY="655.0" />
                  <Button fx:id="secondaryButton" layoutX="490.0" layoutY="572.0" onAction="#login" prefHeight="40.0" prefWidth="243.0" text="Login" />
                  <AnchorPane layoutX="419.0" prefHeight="200.0" prefWidth="270.0">
                     <children>
                        <Label alignment="TOP_LEFT" layoutX="180.0" layoutY="13.0" prefHeight="155.0" prefWidth="157.0" styleClass="website-name" text="HURRICANE&#10;RELIEF&#10;TRACKER" />
                        <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="14.0" layoutY="13.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/hurricane-logo.png" />
                           </image>
                        </ImageView>
                     </children>
                  </AnchorPane>
                  <HBox layoutX="422.0" layoutY="224.0" prefHeight="37.0" prefWidth="360.0">
                     <children>
                        <ToggleButton fx:id="loginToggle" mnemonicParsing="false" onAction="#goToLogin" prefHeight="25.0" prefWidth="180.0" styleClass="auth-toggle" text="Login" />
                        <ToggleButton fx:id="signUpToggle" mnemonicParsing="false" onAction="#goToSignUp" prefHeight="25.0" prefWidth="181.0" styleClass="auth-toggle" text="Sign Up" />
                     </children>
                  </HBox>
                  <AnchorPane layoutX="392.0" layoutY="277.0" prefHeight="141.0" prefWidth="440.0">
                     <children>
                        <Label alignment="CENTER" layoutY="46.0" styleClass="field-label" text="Email" />
                        <TextField fx:id="txt_username" layoutY="71.0" prefHeight="25.0" prefWidth="440.0" />
                     </children>
                  </AnchorPane>
                  <AnchorPane layoutX="392.0" layoutY="386.0" prefHeight="141.0" prefWidth="300.0">
                     <children>
                        <Label alignment="CENTER" layoutY="46.0" text="Password" />
                        <TextField fx:id="txt_password" layoutY="71.0" prefHeight="25.0" prefWidth="440.0" />
                     </children>
                  </AnchorPane>
               </children>
            </Pane>
         </children>
      </AnchorPane>
   </center>
</BorderPane>
