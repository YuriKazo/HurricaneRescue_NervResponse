<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="900.0" prefWidth="1600.0" styleClass="main-background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.HomeController">
   <left>
      <VBox prefHeight="901.0" prefWidth="350.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Pane prefHeight="1047.0" prefWidth="586.0" styleClass="sidebar-background">
               <children>
                  <VBox layoutY="172.0" prefHeight="730.0" prefWidth="351.0">
                     <children>
                        <VBox prefHeight="659.0" prefWidth="343.0">
                           <children>
                              <VBox prefHeight="145.0" prefWidth="344.0">
                                 <children>
                                    <Button fx:id="navHome" alignment="BASELINE_LEFT" graphicTextGap="50.0" mnemonicParsing="false" onAction="#goToHome" prefHeight="72.0" prefWidth="334.0" styleClass="nav-button" text="Home">
                                       <graphic>
                                          <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                                             <image>
                                                <Image url="@images/home-icon.png" />
                                             </image>
                                          </ImageView>
                                       </graphic>
                                    </Button>
                                    <Button fx:id="navMap" alignment="BASELINE_LEFT" graphicTextGap="50.0" mnemonicParsing="false" onAction="#goToMap" prefHeight="72.0" prefWidth="334.0" styleClass="nav-button" text="Map">
                                       <graphic>
                                          <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                                             <image>
                                                <Image url="@images/map-icon.png" />
                                             </image>
                                          </ImageView>
                                       </graphic>
                                    </Button>
                                    <Button fx:id="navCreateRequest" alignment="BASELINE_LEFT" graphicTextGap="50.0" mnemonicParsing="false" onAction="#goToCreateReliefRequest" prefHeight="72.0" prefWidth="334.0" styleClass="nav-button" text="Create Relief Request">
                                       <graphic>
                                          <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                                             <image>
                                                <Image url="@images/request-icon.png" />
                                             </image>
                                          </ImageView>
                                       </graphic>
                                    </Button>
                                 </children>
                              </VBox>
                              <VBox fx:id="loggedOutNav" prefHeight="145.0" prefWidth="334.0">
                                 <children>
                                    <Button fx:id="navLogin" alignment="BASELINE_LEFT" graphicTextGap="50.0" mnemonicParsing="false" onAction="#goToLogin" prefHeight="72.0" prefWidth="334.0" styleClass="nav-button" text="Login">
                                       <graphic>
                                          <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                                             <image>
                                                <Image url="@images/login-logo.png" />
                                             </image>
                                          </ImageView>
                                       </graphic>
                                    </Button>
                                    <Button fx:id="navSignUp" alignment="BASELINE_LEFT" graphicTextGap="50.0" mnemonicParsing="false" onAction="#goToSignUp" prefHeight="94.0" prefWidth="334.0" styleClass="nav-button" text="Sign Up">
                                       <graphic>
                                          <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                                             <image>
                                                <Image url="@images/sign-up-logo.png" />
                                             </image>
                                          </ImageView>
                                       </graphic>
                                    </Button>
                                 </children>
                              </VBox>
                              <VBox fx:id="loggedInNav" prefHeight="75.0" prefWidth="273.0" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <AnchorPane prefHeight="200.0" prefWidth="270.0">
                     <children>
                        <Label alignment="TOP_LEFT" layoutX="180.0" layoutY="13.0" prefHeight="155.0" prefWidth="157.0" styleClass="website-name" text="HURRICANE&#10;RELIEF&#10;TRACKER">
                           <font>
                              <Font size="28.0" />
                           </font></Label>
                        <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="14.0" layoutY="13.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/hurricane-logo.png" />
                           </image>
                        </ImageView>
                     </children>
                  </AnchorPane>
               </children>
            </Pane>
         </children>
      </VBox>
   </left>
   <center>
      <AnchorPane prefHeight="907.0" prefWidth="1301.0" styleClass="main-background" BorderPane.alignment="CENTER">
         <children>
            <Pane layoutX="37.0" layoutY="33.0" prefHeight="836.0" prefWidth="1175.0" styleClass="form-background">
               <children>
                  <Label fx:id="lbl_welcome" alignment="CENTER" contentDisplay="CENTER" layoutX="374.0" layoutY="36.0" prefHeight="102.0" prefWidth="453.0" text="Welcome">
                     <font>
                        <Font size="30.0" />
                     </font>
                  </Label>
                  <VBox alignment="TOP_CENTER" layoutX="225.0" layoutY="201.0" prefHeight="588.0" prefWidth="725.0">
                     <children>
                        <Label prefHeight="129.0" prefWidth="217.0" text="Active Hurricane">
                           <font>
                              <Font size="30.0" />
                           </font>
                        </Label>
                        <ImageView fitHeight="306.0" fitWidth="287.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/hurricane-home-logo.png" />
                           </image>
                        </ImageView>
                        <VBox prefHeight="200.0" prefWidth="100.0" styleClass="hurricane-info-background">
                           <children>
                              <Label fx:id="lbl_hurricane_info" prefHeight="197.0" prefWidth="727.0" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </Pane>
         </children>
      </AnchorPane>
   </center>
</BorderPane>
